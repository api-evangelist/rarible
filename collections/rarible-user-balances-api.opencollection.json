{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAPI definition Charts User balances API",
    "version": "v0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User balances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.rarible.org/v0.1/balances/:currencyId/:owner",
            "params": [
              {
                "name": "currencyId",
                "value": "",
                "type": "path"
              },
              {
                "name": "owner",
                "value": "",
                "type": "path",
                "description": "Address of the token's owner"
              }
            ]
          },
          "docs": "Return user's balance of specified currency"
        }
      ]
    }
  ],
  "bundled": true
}