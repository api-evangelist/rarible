          "id": "bbecf83b-efc4-478b-9ba3-9d545a70cb81",
          "name": "Get historical data of floor price for collection for charting purposes",
          "request": {
            "name": "Get historical data of floor price for collection for charting purposes",
            "description": {
              "content": "Returns list of historical floor prices aggregated at even intervals in the specified time period - last day, last month etc.  Each points represents the aggregated value of the interval after it.  The last point represents the current floor price.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2.0",
                "data",
                "collections",
                ":id",
                "charts",
                "floorPrice"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "(Required) Time period for aggregation"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "(Required) Number of data points to return"
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "Optionally, the date-time of the last point of the graph. Defaults to current time."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Collection ID"
                },
                {
                  "description": " (This can only be one of api,testnet-api)",
                  "type": "any",
                  "value": "{{environment}}",
                  "key": "environment"
                }
              ]
